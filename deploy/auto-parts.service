[Unit]
Description=Auto Parts (static + Favorit API proxy)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/auto-parts
EnvironmentFile=/var/www/auto-parts/.env.server
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
